# Copy to .env for local development — .env is gitignored, this file is NOT.
# Never put real values here. On Vercel, set the same four in
# Project Settings > Environment Variables.

# The OAuth 2.0 client of type "Web application" from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encrypts the session cookie holding the Google refresh token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Comma-separated list of the Google accounts allowed to sign in. The dashboard
# sits on a public URL, so an empty list lets nobody in.
ALLOWED_EMAILS=""
